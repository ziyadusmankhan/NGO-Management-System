APP_NAME="Foundation Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://jtf26kkb-8000.inc1.devtunnels.ms/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite
# MySQL installation: DB_CONNECTION=mysql, then set these values locally.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=foundation_management
# DB_USERNAME=foundation_app
# DB_PASSWORD=
# Temporary local transfer credentials (read only by scripts/mysql-transfer.php):
# MYSQL_MIGRATION_HOST=127.0.0.1
# MYSQL_MIGRATION_PORT=3306
# MYSQL_MIGRATION_DATABASE=foundation_management
# MYSQL_MIGRATION_USERNAME=root
# MYSQL_MIGRATION_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
# Set true for production HTTPS; local HTTP development keeps false.
# null detects HTTPS through the trusted proxy; true is appropriate for HTTPS-only production.
SESSION_SECURE_COOKIE=null
# Generate once with php artisan security:lookup-key. Back up with APP_KEY.
SECURITY_LOOKUP_KEY=
# Comma-separated trusted proxy IPs/CIDRs. Empty trusts no forwarding proxy.
# Local forwarding agents only. Replace with the actual proxy addresses on a server.
TRUSTED_PROXIES=127.0.0.1,::1

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
