APP_NAME="Foundation Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://jtf26kkb-8000.inc1.devtunnels.ms/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
# Set true for production HTTPS; local HTTP development keeps false.
SESSION_SECURE_COOKIE=false
# Generate once with php artisan security:lookup-key. Back up with APP_KEY.
SECURITY_LOOKUP_KEY=
# Comma-separated trusted proxy IPs/CIDRs. Empty trusts no forwarding proxy.
TRUSTED_PROXIES=

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
